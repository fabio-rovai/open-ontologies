        [ sh:datatype xsd:short ;
            sh:maxCount 1 ;
            sh:name "short" ;
            sh:path ex:objectTypeWithAllPropertyTypes.short ],
        [ sh:datatype xsd:short ;
            sh:name "shortArray" ;
            sh:path ex:objectTypeWithAllPropertyTypes.shortArray ],
        [ sh:maxCount 1 ;
            sh:name "mediaReference" ;
