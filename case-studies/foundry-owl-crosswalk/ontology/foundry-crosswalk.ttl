fcx:fidelity a owl:AnnotationProperty ;
    rdfs:comment "How faithfully the Foundry type crossed into standards." .

fcx:foundryDetail a owl:AnnotationProperty ;
    rdfs:comment "Foundry type detail with no standards counterpart." .

fcx:foundryElementType a owl:AnnotationProperty ;
    rdfs:comment "The element type of a Foundry array property." .

fcx:foundryRid a owl:AnnotationProperty ;
    rdfs:comment "The Foundry resource identifier the term came from." .

fcx:foundryType a owl:AnnotationProperty ;
    rdfs:comment "The Foundry property type discriminator." .

fcx:titleProperty a owl:AnnotationProperty ;
    rdfs:comment "The Foundry display title property." .

fcx:unmappable a owl:AnnotationProperty ;
    rdfs:comment "Marks a term whose Foundry meaning has no standards counterpart." .

