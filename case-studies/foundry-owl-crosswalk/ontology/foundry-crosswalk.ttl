            sh:path ex:objectTypeWithAllPropertyTypes.geoPoint ],
        [ sh:maxCount 1 ;
            sh:name "attachment2" ;
            sh:path ex:objectTypeWithAllPropertyTypes.attachment2 ],
        [ sh:datatype xsd:int ;
            sh:maxCount 1 ;
            sh:name "integer" ;
            sh:path ex:objectTypeWithAllPropertyTypes.integer ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
