@prefix ex: <https://ontology.tesseract.academy/foundry-crosswalk/> .
@prefix fcx: <https://ontology.tesseract.academy/foundry-crosswalk/meta#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology ;
    rdfs:label "Palantir OSDK shared test fixtures" ;
    rdfs:comment "Assembled from the fixtures Palantir publishes in palantir/osdk-ts to mock the Foundry Ontology API." .

ex:BarInterface a owl:Class ;
    rdfs:label "Bar Interface" ;
    rdfs:comment "Interface for Bar" ;
    fcx:foundryRid "ri.interface.main.interface.2" .

ex:BgaoNflPlayer.address.StructShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:int ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.address.zipCode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.address.city ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.address.state ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.address.addressLine1 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.address.addressLine2 ] ;
    sh:targetClass ex:BgaoNflPlayer.address.Struct .

ex:BgaoNflPlayer.addressArray.StructShape a sh:NodeShape ;
    sh:property [ sh:datatype geo:wktLiteral ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.addressArray.location ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.addressArray.addressLine1 ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.addressArray.addressLine2 ],
        [ sh:datatype xsd:int ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.addressArray.zipCode ],
        [ sh:datatype geo:wktLiteral ;
            sh:maxCount 1 ;
            sh:path ex:BgaoNflPlayer.addressArray.city ] ;
    sh:targetClass ex:BgaoNflPlayer.addressArray.Struct .

ex:BgaoNflPlayerShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:int ;
            sh:maxCount 1 ;
            sh:name "gamesPlayed" ;
            sh:path ex:BgaoNflPlayer.gamesPlayed ],
        [ sh:datatype xsd:int ;
            sh:maxCount 1 ;
            sh:name "number" ;
            sh:path ex:BgaoNflPlayer.number ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "id" ;
            sh:path ex:BgaoNflPlayer.id ],
        [ sh:class ex:BgaoNflPlayer.addressArray.Struct ;
            sh:name "addressArray" ;
            sh:path ex:BgaoNflPlayer.addressArray ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "name" ;
            sh:path ex:BgaoNflPlayer.name ],
        [ sh:class ex:BgaoNflPlayer.address.Struct ;
            sh:maxCount 1 ;
            sh:name "address" ;
            sh:path ex:BgaoNflPlayer.address ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "wikiUrl" ;
            sh:path ex:BgaoNflPlayer.wikiUrl ] ;
    sh:targetClass ex:BgaoNflPlayer .

ex:Employee.employeeProfile.StructShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:int ;
            sh:maxCount 1 ;
            sh:path ex:Employee.employeeProfile.yearsExperience ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ex:Employee.employeeProfile.bio ] ;
    sh:targetClass ex:Employee.employeeProfile.Struct .

ex:EmployeeShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:name "startDate" ;
            sh:path ex:Employee.startDate ],
        [ sh:maxCount 1 ;
            sh:name "employeeSensor" ;
            sh:path ex:Employee.employeeSensor ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "office" ;
            sh:path ex:Employee.office ],
        [ sh:maxCount 1 ;
            sh:name "employeeLocation" ;
            sh:path ex:Employee.employeeLocation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "class" ;
            sh:path ex:Employee.class ],
        [ sh:class ex:Employee ;
            sh:name "peeps" ;
            sh:path ex:link.Employee.peeps ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "skillSet" ;
            sh:path ex:Employee.skillSet ],
        [ sh:datatype xsd:double ;
            sh:name "performanceScores" ;
            sh:path ex:Employee.performanceScores ],
        [ sh:class ex:Office ;
            sh:maxCount 1 ;
            sh:name "officeLink" ;
            sh:path ex:link.Employee.officeLink ],
        [ sh:class ex:Employee.employeeProfile.Struct ;
            sh:maxCount 1 ;
            sh:name "employeeProfile" ;
            sh:path ex:Employee.employeeProfile ],
        [ sh:class ex:Employee ;
            sh:maxCount 1 ;
            sh:name "lead" ;
            sh:path ex:link.Employee.lead ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "fullName" ;
            sh:path ex:Employee.fullName ],
        [ sh:maxCount 1 ;
            sh:name "skillSetEmbedding" ;
            sh:path ex:Employee.skillSetEmbedding ],
        [ sh:maxCount 1 ;
            sh:name "employeeStatus" ;
            sh:path ex:Employee.employeeStatus ],
        [ sh:datatype xsd:int ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "employeeId" ;
            sh:path ex:Employee.employeeId ],
        [ sh:datatype xsd:string ;
            sh:name "favoriteRestaurants" ;
            sh:path ex:Employee.favoriteRestaurants ] ;
    sh:targetClass ex:Employee .

ex:FooInterface a owl:Class ;
    rdfs:label "Foo Interface" ;
    rdfs:comment "Interface for Foo" ;
    fcx:foundryRid "ri.interface.main.interface.1" .

