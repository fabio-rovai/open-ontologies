            sh:path ex:objectTypeWithAllPropertyTypes.attachmentArray ],
        [ sh:datatype xsd:string ;
            sh:name "stringArray" ;
            sh:path ex:objectTypeWithAllPropertyTypes.stringArray ],
        [ sh:datatype xsd:dateTime ;
            sh:name "dateTimeArray" ;
