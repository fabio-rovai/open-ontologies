ex:Employee.class a owl:DatatypeProperty ;
    rdfs:label "class" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string ;
    fcx:fidelity "direct" ;
    fcx:foundryType "string" .

ex:Employee.employeeLocation a owl:DatatypeProperty ;
    rdfs:label "employeeLocation" ;
    rdfs:comment "Geotime series reference of the location of the employee",
        "Not carried by the crosswalk. A handle onto a Geotime integration. The track is not in the export." ;
    rdfs:domain ex:Employee ;
    fcx:fidelity "none" ;
    fcx:foundryType "geotimeSeriesReference" ;
    fcx:unmappable true .

ex:Employee.employeeProfile a owl:ObjectProperty ;
    rdfs:label "employeeProfile" ;
    rdfs:comment "Employee profile with main value being the bio" ;
    rdfs:domain ex:Employee ;
    rdfs:range ex:Employee.employeeProfile.Struct ;
    fcx:fidelity "structural" ;
    fcx:foundryType "struct" .

ex:Employee.employeeProfile.bio a owl:DatatypeProperty ;
    rdfs:label "bio" ;
    rdfs:domain ex:Employee.employeeProfile.Struct ;
    rdfs:range xsd:string ;
    fcx:foundryType "string" .

ex:Employee.employeeProfile.yearsExperience a owl:DatatypeProperty ;
    rdfs:label "yearsExperience" ;
    rdfs:domain ex:Employee.employeeProfile.Struct ;
    rdfs:range xsd:int ;
    fcx:foundryType "integer" .

ex:Employee.employeeSensor a owl:DatatypeProperty ;
    rdfs:label "employeeSensor" ;
    rdfs:comment "Not carried by the crosswalk. A handle onto a Foundry time series, not a value. The series itself is not in the export.",
        "TimeSeries sensor of the status of the employee" ;
    rdfs:domain ex:Employee ;
    fcx:fidelity "none" ;
    fcx:foundryDetail "itemType={\"type\": \"string\"}" ;
    fcx:foundryType "timeseries" ;
    fcx:unmappable true .

ex:Employee.employeeStatus a owl:DatatypeProperty ;
    rdfs:label "employeeStatus" ;
    rdfs:comment "Not carried by the crosswalk. A handle onto a Foundry time series, not a value. The series itself is not in the export.",
        "TimeSeries of the status of the employee" ;
    rdfs:domain ex:Employee ;
    fcx:fidelity "none" ;
    fcx:foundryDetail "itemType={\"type\": \"string\"}" ;
    fcx:foundryType "timeseries" ;
    fcx:unmappable true .

ex:Employee.favoriteRestaurants a owl:DatatypeProperty ;
    rdfs:label "favoriteRestaurants" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string ;
    fcx:fidelity "direct" ;
    fcx:foundryElementType "string" ;
    fcx:foundryType "array" .

ex:Employee.fullName a owl:DatatypeProperty ;
    rdfs:label "fullName" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string ;
    fcx:fidelity "direct" ;
    fcx:foundryType "string" .

ex:Employee.office a owl:DatatypeProperty ;
    rdfs:label "office" ;
    rdfs:comment """The unique "ID" of the employee's \\"primary\\" assigned office.
 This is some more text.""" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string ;
    fcx:fidelity "direct" ;
    fcx:foundryType "string" .

ex:Employee.performanceScores a owl:DatatypeProperty ;
    rdfs:label "performanceScores" ;
    rdfs:comment "Array of performance scores with reducers" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:double ;
    fcx:fidelity "direct" ;
    fcx:foundryElementType "double" ;
    fcx:foundryType "array" .

ex:Employee.skillSet a owl:DatatypeProperty ;
    rdfs:label "skillSet" ;
    rdfs:comment "The skills of the employee" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string ;
    fcx:fidelity "direct" ;
    fcx:foundryType "string" .

ex:Employee.skillSetEmbedding a owl:DatatypeProperty ;
    rdfs:label "skillSetEmbedding" ;
    rdfs:comment "Not carried by the crosswalk. An embedding. The export declares its dimension and sometimes the producing model, but no W3C datatype carries a vector, so both become annotations rather than a range.",
        "Vectorized skill set" ;
    rdfs:domain ex:Employee ;
    fcx:fidelity "none" ;
    fcx:foundryDetail "dimension=1536",
        "embeddingModel={\"type\": \"lms\", \"value\": \"OPENAI_TEXT_EMBEDDING_ADA_002\"}" ;
    fcx:foundryType "vector" ;
    fcx:unmappable true .

ex:Employee.startDate a owl:DatatypeProperty ;
    rdfs:label "startDate" ;
    rdfs:comment "The date the employee was hired (most recently, if they were re-hired)" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:date ;
    fcx:fidelity "direct" ;
    fcx:foundryType "date" .

ex:ObjectWithTimestampPrimaryKey.value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:domain ex:ObjectWithTimestampPrimaryKey ;
    rdfs:range xsd:string ;
    fcx:fidelity "direct" ;
    fcx:foundryType "string" .

