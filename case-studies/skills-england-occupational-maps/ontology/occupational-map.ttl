    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/20> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/13> ;
    seom:involvedEmployers "Dunelm, B&Q, Morleys (SME), Tesco, JD Sports, Carphone Warehouse, Paul Smith, Specsavers, BIRA (SME), House of Fraser, Jigsaw, Morrison’s" ;
    seom:keyword "brand",
        "degree",
        "leadership",
        "retail",
