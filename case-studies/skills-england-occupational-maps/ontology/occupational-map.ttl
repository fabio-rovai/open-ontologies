    seom:involvedEmployers "Astra Zeneca, Croda, Labcorp, Reading Scientific Services Limited, Sterling Pharma Solutions, UCB.Com, Vertex Pharmaceuticals Incorporated, Victrex, SABIC, Centre for Process Innovation, Fujifilm, HMG Paints" ;
    seom:keyword "Technician Scientist",
