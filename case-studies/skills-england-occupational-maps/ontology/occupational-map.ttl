        "apartments",
        "estate",
        "flats",
        "housing",
        "marketing",
        "property",
        "retail",
        "sales",
        "selling" ;
    seom:level 2 ;
    seom:overview "Working in different areas of an estate agent completing tasks such as arranging viewings and accompanying colleagues on site visits to various properties." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0070>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0234>,
