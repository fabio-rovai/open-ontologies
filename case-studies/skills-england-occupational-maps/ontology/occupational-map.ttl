    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "Berthon Boat Company (chair), Broom Boats, English Harbour Yachts, Fairline Boats, Golden Arrow, Goodchild Marine, Green Marine, Hamble Yacht Services, RNLI, Pendennis Shipyard, Princess Yachts, Pioneer Sailing Trust, Sunseeker International, Windboats" ;
    seom:keyword "boat",
        "design",
