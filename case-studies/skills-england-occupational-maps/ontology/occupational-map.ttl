        <https://gov.tesseract.academy/id/seom/occupation/OCC0592A>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0592B>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0592C>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0592D>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0621>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0842>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0875> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/5119> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/5119> ;
    seom:statusLastUpdated "2021-07-01"^^xsd:date ;
    seom:stdCode "OCC0952" ;
    seom:typicalJobTitle "Commercial fisher",
        "Fisher",
        "Fisherman",
