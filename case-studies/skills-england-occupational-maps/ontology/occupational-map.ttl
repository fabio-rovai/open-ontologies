    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/1> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/5> ;
    seom:involvedEmployers "Stone Technical Services Group LTD, SWAT International Ltd, Pendrich Height Services Ltd, Premier Technical Services Group Ltd" ;
    seom:keyword "climbing",
        "outdoors",
        "scaffolding",
        "steeples",
        "towers" ;
    seom:level 2 ;
    seom:overview "Conduct routine inspections, maintenance tasks and minor planned and responsive repair works to buildings and structures at height." ;
