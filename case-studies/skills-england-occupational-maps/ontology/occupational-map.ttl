        <https://gov.tesseract.academy/id/seom/occupation/OCC1398> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/2133> ;
    seom:statusLastUpdated "2025-12-10"^^xsd:date ;
    seom:stdCode "OCC1512" ;
