    seom:involvedEmployers "APC, Bibby, CitySprint, Diamond Logistics, Delivered, DPD, DX, Fedex, GLH, Gnewt, Hermes, Point to Point, Rush, Swift Group, TNT, UK Mail, Yodel" ;
    seom:keyword "Express Delivery Operative",
