    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "Contrax Furniture Ltd , Crofts & Assinder Ltd, Dalbergia Ltd, Ercol, Howdens Joinery, N E J Stevenson Ltd, OCEE Interiors, Roundhouse Design - SE, SB Joinery, Shackletons Ltd, Simon Thomas Pirie Ltd, Struik and Hamerslag UK Ltd." ;
