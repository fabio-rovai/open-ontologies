        "recruitment" ;
    seom:level 4 ;
    seom:overview "Helping people to address and overcome obstacles to secure employment." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0694> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/3562> ;
