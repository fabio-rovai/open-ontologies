    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "AWE, Cavendish Nuclear, Cogent, EDF Energy, Gen2, LLWR, Magnox Ltd, NNL, NSAN, Nuclear Institute, Sellafield, Westinghouse, Wood plc" ;
    seom:keyword "Nuclear",
        "Nuclear Operative",
        "Operative",
        "nuclear environment",
        "nuclear facilities" ;
    seom:level 2 ;
    seom:overview "Responsible for the operation of plant systems and equipment on nuclear facilities." ;
