    seom:inRoute <https://gov.tesseract.academy/id/seom/route/10> ;
    seom:involvedEmployers "Barts Health NHS Trust, Barking, Havering and Redbridge University Hospitals NHS Trust, Blackpool Teaching Hospitals NHS Foundation Trust, Buckinghamshire Healthcare NHS Trust, Chelsea & Westminster Hospital NHS Trust, Frimley Health NHS Foundation Trust, Leeds Teaching Hospital Trust, London North West University Healthcare NHS Trust, Medway NHS Foundation Trust, Oxford University Hospitals NHS Foundation Trust, St Helens and Knowsley Teaching Hospitals NHS Trust, United Lincolnshire Hospitals NHS Trust, University Hospitals Morecambe Bay NHS." ;
