    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "Jaguar Land Rover, Ford, Caterpillar, Mercedes F1, Intertek, Horiba Mira, Honda, Autocraft Drivetrain Solutions, Millbrook, Mahle Powertrain, Perkins, AVL Powertrain, Nissan Technical Centre" ;
    seom:keyword "Propulsion technician",
        "engineering",
