    seom:inRoute <https://gov.tesseract.academy/id/seom/route/5> ;
    seom:involvedEmployers "BAM Nuttall, BYLOR, Expanded Ltd, Laing O'Rourke, T3 UK, The Skills Centre" ;
    seom:keyword "building surveys",
        "concrete",
        "construction",
        "engineering",
        "fitting steel",
        "steel",
        "steelworks" ;
    seom:level 2 ;
    seom:overview "Assembling and installing steelworks required to strengthen reinforced concrete structures." ;
