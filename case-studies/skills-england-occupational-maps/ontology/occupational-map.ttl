    seom:inRoute <https://gov.tesseract.academy/id/seom/route/2> ;
    seom:involvedEmployers "Care Quality Commission, Cabinet Office, Cambridge and Peterborough Councils, Citizens Advice, Cancer Research, Hackney Council, Girl Guides, Public Health England, Practical Service Design, Department for Education, Red Cross, HMRC, NHS, Snook, Adur and Worthing Councils" ;
    seom:keyword "IT",
        "design",
        "digital",
        "management",
        "service designer",
        "users",
        "ux" ;
