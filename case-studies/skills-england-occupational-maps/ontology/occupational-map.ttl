    seom:involvedEmployers "Crossrail, Network Rail, HS1, Transport for London , GWR" ;
    seom:keyword "customer service",
        "operational",
        "rail network operations",
        "rail transport",
        "railway signalling" ;
    seom:level 3 ;
    seom:overview "Operating the signals and electrical controls needed to keep trains running safely and on time." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0316A>,
