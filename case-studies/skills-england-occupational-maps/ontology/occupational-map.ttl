    seom:level 7 ;
    seom:overview "Work to improve children’s mental health, emotional well-being, learning capabilities and social relationships." ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/2229> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/2229> ;
