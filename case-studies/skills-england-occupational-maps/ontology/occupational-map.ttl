    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/1> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/5> ;
    seom:involvedEmployers "Cambridge Regional College, Altrad, CGB Humbertherm, Envirotherm, Essex Thermal, Kaefer Ltd, Powertherm Contract Services, TICA" ;
    seom:keyword "Insulation Technician",
        "Technician",
        "Thermal",
        "Thermal Insulation",
        "Thermal Insulation Technician" ;
    seom:level 3 ;
    seom:overview "Applying and fabricating insulation and cladding materials." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC1334> ;
