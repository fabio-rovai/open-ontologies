    seom:inRoute <https://gov.tesseract.academy/id/seom/route/13> ;
    seom:involvedEmployers "Aspire Housing Ltd, Spectrum Housing Group Ltd, Your Housing Group, Rendall & Ritner Ltd, Coast & Country Housing Ltd, St Basil’s, B3 Living Ltd, Crosby Housing Association Ltd, Genesis Housing Association Ltd, Innisfree Housing Association, Yarlington Housing Group, The Guinness Partnership, Chartered Institute of Housing, Institute of Residential Property Management Ltd, Sovereign Housing, Barnet Housing, Family Mosaic, Community Housing Group, New Charter Group, Association of Registered Letting Agents, National Housing Federation, Affinity Sutton Group, Futures Housing Group" ;
