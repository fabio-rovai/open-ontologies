    seom:involvedEmployers "Land registry, Sainsburys, HMRC, Capita, Cision, CK Delta, Home office, Office for national statistics," ;
    seom:level 4 ;
    seom:overview "Drive and manage digital products through the complete product lifecycle." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0482C>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0482G>,
