        "healthcare environment",
        "incidents and emergencies",
        "intermediate life support" ;
    seom:level 4 ;
    seom:overview "Responding to 999 and urgent calls, and providing emergency care for people as part of an ambulance crew." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0567> ;
