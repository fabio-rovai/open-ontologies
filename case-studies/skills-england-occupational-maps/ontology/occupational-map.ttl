<https://gov.tesseract.academy/id/seom/occupation/OCC0038C> a seom:Occupation ;
    rdfs:label "Aviation ground specialist - Fire Fighter" ;
    dct:description "An aviation operations specialist could work in a number of aviation environments, such as a commercial airport, military base / aerodrome, heliport or other airfield. Specialist roles, all focussed around the arrival, turnaround and departure of aircraft and maintaining an aviation operation, will include knowledge, skills and behaviours to complete complex aviation tasks and may include supervision of others to enable compliance with regulations through a safe, secure and effective aviation operation. These functions may include loading and unloading of aircraft, air traffic control (ATC), movement of aircraft and vehicles airside and the management of passengers both airside and landside. The functions all work as part of a combined team, within which communication with wider colleagues and other stakeholders is essential and the aviation operations specialist plays a key part of a coherent operation. The core knowledge, skills and behaviours must be completed by ALL ground specialists, along with ONE of the five specialist functions." ;
    skos:prefLabel "Aviation ground specialist - Fire Fighter" ;
    seom:atTechnicalLevel <https://gov.tesseract.academy/id/seom/technical-level/1> ;
    seom:deliveredThrough <https://gov.tesseract.academy/id/seom/product/ST0038> ;
    seom:hasStatus <https://gov.tesseract.academy/id/seom/status/1> ;
    seom:inCluster <https://gov.tesseract.academy/id/seom/cluster/16> ;
    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/11> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/15> ;
    seom:involvedEmployers "London Heathrow Airport, Swissport UK, RNAS, London City Airport, Bristow Group, Royal Air Force, Menzies Aviation, Army Air Corps, Royal Artillery, Royal Logistics Corps, Edinburgh Airport Manager, British Airways, dnata UK" ;
    seom:keyword "Planes",
        "air cargo",
        "air traffic control",
        "aircraft handling",
        "aircraft movement",
        "airport ground handling",
        "aviation ground handling",
        "civil aviation",
        "flight operations",
        "passenger services",
        "terminal control centre" ;
    seom:level 3 ;
    seom:overview "Working in a specialist role supervising the safe arrival, turnaround and departure of aircraft at airports, military bases, heliports and other airfields." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0039D>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0486> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/8233> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/3313> ;
    seom:statusLastUpdated "2016-04-14"^^xsd:date ;
