    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "EDF Energy, Royal Navy" ;
    seom:keyword "defence",
        "engineering",
        "manufacturing",
        "nuclear",
        "processing engineer" ;
    seom:level 6 ;
    seom:overview "Operate, monitor and control the nuclear reactor and associated equipment in normal operational mode, as well as abnormal conditions." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0289> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/2127> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/2129> ;
    seom:statusLastUpdated "2021-05-06"^^xsd:date ;
    seom:stdCode "OCC0784" ;
