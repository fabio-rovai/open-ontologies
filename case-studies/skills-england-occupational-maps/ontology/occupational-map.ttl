        "critical illness",
        "g life assurance",
        "housing",
        "income protection and buildings",
        "money",
        "sickness and unemployment" ;
    seom:level 3 ;
    seom:overview "Giving clients advice on appropriate mortgages and related protection products such as life insurance or sickness and unemployment insurance." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0241> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/3534> ;
