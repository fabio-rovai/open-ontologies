    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "Roxel Group UK Ltd, BAE Systems Maritime, AWE, Falcon Project, BAE Systems Weapons, MBDA, DSTL, MOD, AWE, Roxel UK Ltd, RAF, British Army Royal Logistics Core, QinetiQ, DE&S" ;
    seom:keyword "OME",
