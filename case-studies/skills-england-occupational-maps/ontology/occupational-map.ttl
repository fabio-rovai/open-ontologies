        <https://gov.tesseract.academy/id/seom/occupation/OCC0945>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0966> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/3563> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/2312> ;
