    seom:inRoute <https://gov.tesseract.academy/id/seom/route/15> ;
    seom:involvedEmployers "BA, BA City Flyer, Flybe, Royal Air Force, Monarch, Easyjet, Thomas Cook, Virgin, Eastern Airways, BMI Regional, Titan Airways" ;
    seom:keyword "air cabin",
        "airways",
        "customer service",
        "logistics",
        "transport" ;
    seom:level 3 ;
    seom:overview "Providing excellent customer service to passengers while ensuring their comfort and safety throughout the flight." ;
