        "foundation doctor",
        "health",
        "health professional",
        "medicine",
        "science" ;
    seom:level 7 ;
    seom:overview "Applying the principles and procedures of medicine to assess, prevent, diagnose, care for and treat patients with illness, disease and injury and to maintain physical and mental health." ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/2211> ;
