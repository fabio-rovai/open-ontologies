    seom:inRoute <https://gov.tesseract.academy/id/seom/route/10> ;
    seom:involvedEmployers "Hull Tigers , Premier League, Rugby Football Union, Rugby Football League, Widnes Vikings, England and Wales Cricket Board, City Football Group, Leicester City FC, Charlton Athletic FC, Portsmouth FC, Derby County FC, Sheffield Wednesday FC, League Football Education, British Racing School," ;
