    seom:inRoute <https://gov.tesseract.academy/id/seom/route/3> ;
    seom:involvedEmployers "Parkdean Resorts UK Ltd, Bourne Leisure (medium), Firmdale, Marriott, James' Places, Dalata Hotel Group, Dakota Hotels, Intercontinental Hotel Group, Leonardo Hotels UK and Ireland, The Castle at Taunton, The Inn Collection Group, Whitbread, SSP, Kew Green Hotels, Lakeland Hoteliers Association." ;
    seom:keyword "Hospitality accommodation team member",
