        "conference centres",
        "customer experience",
        "customer service",
        "drink",
        "drinking",
        "eating",
        "food",
        "hotels or contract caterers",
        "restaurants" ;
    seom:level 2 ;
    seom:overview "Carrying out a range of general and specialist roles within hospitality businesses, including bars, cafes, conference centres, restaurants and hotels." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC1420> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/9264> ;
    seom:statusLastUpdated "2024-12-18"^^xsd:date ;
    seom:stdCode "OCC1488" ;
