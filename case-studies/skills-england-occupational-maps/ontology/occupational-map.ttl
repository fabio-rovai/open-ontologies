        <https://gov.tesseract.academy/id/seom/occupation/OCC0845>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0960> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/3114> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/3114> ;
    seom:statusLastUpdated "2017-10-04"^^xsd:date ;
