    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/9260> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/9252> ;
    seom:statusLastUpdated "2016-06-24"^^xsd:date ;
