    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/33> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/5> ;
    seom:involvedEmployers "Cabinet Office, Jigsaw, Kier Group plc, NHS Property Services Ltd, Ministry of Justice, Engie, Mitie Group Plc, Mara Services & Supplies Ltd, Interserve, Fame Services, Carillion Plc, Amazon" ;
    seom:keyword "degree",
