    seom:involvedEmployers """Telefonica, Army Air Corps, Royal Artillery, Royal Armoured Corp, Digital Skills UK, TC Partnership
Babcock, Learning Curve, BT, Virgin media""" ;
    seom:keyword "digital",
        "digital support",
        "ict",
        "network",
        "radio",
        "services",
