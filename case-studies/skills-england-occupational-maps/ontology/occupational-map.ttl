    seom:inRoute <https://gov.tesseract.academy/id/seom/route/5> ;
    seom:involvedEmployers "Centrica, Calor Gas, Scottish Power, Currys, EDF, Cadent Gas, Wales & Wales Utilities, Homeserve, SGN, Northern Gas Networks, Ideal Heating." ;
    seom:keyword "Gas Safe",
        "electrical safety checks",
        "engineering",
        "flue testing",
        "gas",
        "gas safe registration" ;
    seom:level 3 ;
    seom:overview "Installing and maintaining gas appliances in a domestic or non-domestic setting, advising customers on how appliances work and how to use energy more efficiently." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0041>,
