        "environment",
        "manufacturing",
        "recycling",
        "sorting" ;
    seom:level 2 ;
    seom:overview "Identifying different metals, sorting and separating them into grades" ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0545> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/9235> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/9225> ;
    seom:statusLastUpdated "2018-08-07"^^xsd:date ;
