        <https://gov.tesseract.academy/id/seom/product/ST0596> ;
    seom:hasStatus <https://gov.tesseract.academy/id/seom/status/1> ;
    seom:inCluster <https://gov.tesseract.academy/id/seom/cluster/98> ;
