    seom:inCluster <https://gov.tesseract.academy/id/seom/cluster/261> ;
    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/66> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "Aspley Workwear, Bates of London, Berendsen, Central Laundry, Crystal Laundry, Imperial Laundry, Johnson Service Group, Laundry World, Micronclean, NHS Salisbury, Royal Jersey, Swiss Camplings Group, Total Laundry" ;
    seom:keyword "Textile Care Operative",
        "care",
