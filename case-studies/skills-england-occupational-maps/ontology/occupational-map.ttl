    seom:inGreenTheme <https://gov.tesseract.academy/id/seom/green-theme/4> ;
    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/9> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/10> ;
    seom:involvedEmployers "Unilever, GSK, Medimmune, Astrazeneca, Fujifilm Diosynth, Eagle Genomics, Covance, Envigo, UCB, Kymab, EMBL-European Bioinformatics Institute, Medical Research Council, Genomics England, Association of British Pharmaceutical Industry, Biochemical Society, Royal Society of Biology, Royal Society of Chemistry" ;
    seom:keyword "analytical science services",
        "bioinformatics",
        "computational",
        "data",
        "life sciences",
        "science" ;
    seom:level 7 ;
    seom:overview "Specialists who use computational, data analytical and data mining techniques which are applied to a range of problems in the life sciences." ;
