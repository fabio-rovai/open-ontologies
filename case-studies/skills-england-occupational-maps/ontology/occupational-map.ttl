    seom:level 6 ;
    seom:overview "Specify, design, build, program and test robotic systems or solutions intended to do automated jobs." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0672>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0856>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC1381> ;
