    seom:inRoute <https://gov.tesseract.academy/id/seom/route/3> ;
    seom:involvedEmployers "1st Awards, Army Catering, Army Catering Training Trust (ACTT), Aspens-Services, Azzurri Central, City and Guilds, Compass Group, Elior UK, English Heritage, Excel Care Holdings, Greene King, HIT Training, Innovate Awarding, Inspiro Learning, James' Places, Leonardo Hotels UK and Ireland, Lifetime Training, Marstons, Mitchells and Butler, National Federation of Fish Friers, Nottinghamshire Healthcare NHS Foundation Trust, Parkdean Resorts UK Ltd, Professional Assessment Ltd., Royal Air Force, Royal Navy, Skills Education Group, St Austell Brewery, Stonegate, TGI Friday, Whitbread, SSP" ;
    seom:keyword "Chef",
