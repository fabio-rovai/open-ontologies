    seom:inRoute <https://gov.tesseract.academy/id/seom/route/2> ;
    seom:involvedEmployers "Community Energy England, Oldham Council, Plymouth Council, Bath and West Community Energy, Sharenergy, Sandwell Council, Bristol Council, Plymouth Energy Community, Oldham Community Power, Bristol Energy Cooperative, Centre for Alternative Technology, Repowering London, My Green Investment, Camden Council, E.ON Energy" ;
    seom:keyword "Community",
        "Community Energy Specialist",
        "Energy",
        "Energy Specialist",
        "Specialist" ;
    seom:level 4 ;
    seom:overview "Helping communities work together to reduce energy use and costs. Promoting energy efficient heating." ;
