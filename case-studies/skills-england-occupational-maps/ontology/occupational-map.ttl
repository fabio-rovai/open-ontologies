    seom:involvedEmployers "Score Energy, Siemens Industrial Turbomachinery Ltd, Uniper, WSP, R-MC Power Recovery Ltd, Flakt Group, Bladon Jet, Royal Air Force, Defence Science and Technology Laboratory, Easy Jet, Total UK Limited" ;
    seom:keyword "engineering",
        "gas",
        "gas turbine systems",
        "manufacturing",
        "power",
        "propulsion" ;
    seom:level 7 ;
    seom:overview "Design and develop, operate and maintain gas turbine systems." ;
    seom:statusLastUpdated "2020-08-07"^^xsd:date ;
