<https://gov.tesseract.academy/id/seom/occupation/OCC0182> a seom:Occupation ;
    rdfs:label "Mortgage advisor" ;
    dct:description "The role of a qualified mortgage adviser is to identify and satisfy customer mortgage requirements and associated protection needs, through fully compliant regulated meetings. These meetings can take place in a variety of environments, depending on the type of employer including face to face (either in business premises or in a customer’s home) or over the telephone. In addition to giving advice on appropriate mortgage products, the mortgage adviser also advises on related protection products including life assurance, critical illness, accident, sickness and unemployment, income protection and buildings and contents insurance. This apprenticeship offers an ideal entry point for a career in the mortgage advice sector or for potential progression into other Financial Services roles and can attract candidates from various backgrounds with differing skills and experience." ;
    skos:prefLabel "Mortgage advisor" ;
    seom:atTechnicalLevel <https://gov.tesseract.academy/id/seom/technical-level/1> ;
    seom:deliveredThrough <https://gov.tesseract.academy/id/seom/product/ST0182>,
        <https://gov.tesseract.academy/id/seom/product/TL0010a> ;
    seom:hasStatus <https://gov.tesseract.academy/id/seom/status/1> ;
    seom:inCluster <https://gov.tesseract.academy/id/seom/cluster/242> ;
    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/63> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/11> ;
    seom:involvedEmployers "Barclays, Lloyds, Santander, HSBC, Nationwide, Leeds Building Society, Skipton Building Society, Openwork, Sesame Bankhall Group, Simply Biz Mortgages, Mortgage Advice Bureau, The Right Equity Release" ;
    seom:keyword "Houses",
        "accident",
