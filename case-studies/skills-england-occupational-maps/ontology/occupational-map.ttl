    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers """Antich and Sons (Huddersfield) \r
A W Hainsworth and Sons\r
Burberry\r
Camira Fabrics \r
Heathcoats\r
John Lewis\r
John Spencer\r
Milliken\r
Pennine Weavers \r
WooltexUK \r
WT Johnson and Sons Ltd""" ;
