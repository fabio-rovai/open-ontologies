        "Software Developer",
        "business analysis",
        "code",
        "computers",
        "degree",
        "development",
        "software analysis",
        "tech",
        "technology" ;
    seom:level 6 ;
    seom:overview "Maintaining digital and technology strategies through technology leadership." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0482D>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0482E>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0482F>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0482H>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0482I>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0482K> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/2136> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/2135> ;
    seom:statusLastUpdated "2015-03-26"^^xsd:date ;
    seom:stdCode "OCC0119B" ;
    seom:typicalJobTitle "Business analyst",
        "Computing data analyst",
        "Cyber security professional",
        "It consultant",
        "Network engineer",
        "Software engineer" ;
    seom:versionNo "1.2" .

