    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/59> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/7> ;
    seom:involvedEmployers "Sumo Digital Group PLC, Rare (Microsoft), PlayStation London Studio (Sony), Red Kite Games, Co-operative Innovations, The Chinese Room, Hutch Games, nDreams, Aardvark Swift" ;
    seom:keyword "Digital",
        "Digital design",
        "Digital production",
