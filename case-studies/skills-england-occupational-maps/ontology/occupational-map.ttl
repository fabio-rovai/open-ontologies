        "payroll" ;
    seom:level 3 ;
    seom:overview "Setting up and operating the payroll within the organisation in which they are employed or on behalf of another organisation." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0869>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC1484> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/4122> ;
