    seom:inRoute <https://gov.tesseract.academy/id/seom/route/10> ;
    seom:involvedEmployers "East Midlands Ambulance Service NHS Trust, East of England Ambulance Service NHS Trust, Isle of Wight Healthcare NHS PCT Trust, London Ambulance Service NHS Trust, North West Ambulance Service NHS Trust, North East Ambulance Service NHS Foundation Trust, South Central Ambulance Service NHS Foundation Trust, South East Coast Ambulance Service NHS Foundation Trust, South Western Ambulance Service NHS Foundation Trust, West Midlands Ambulance Service NHS Foundation Trust, Yorkshire Ambulance Service NHS Trust" ;
    seom:keyword "ambulance crew",
