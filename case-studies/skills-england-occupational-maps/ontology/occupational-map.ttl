    seom:level 2 ;
    seom:overview "Support the operation of a farm." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0761A>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0761B>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC1320> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/9111> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/5111> ;
    seom:statusLastUpdated "2021-05-17"^^xsd:date ;
