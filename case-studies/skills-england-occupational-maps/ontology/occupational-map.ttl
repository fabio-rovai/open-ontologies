    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0482I>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0482J> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/2136> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/2134> ;
    seom:statusLastUpdated "2015-03-26"^^xsd:date ;
    seom:stdCode "OCC0119D" ;
