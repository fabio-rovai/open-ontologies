    seom:inCluster <https://gov.tesseract.academy/id/seom/cluster/264> ;
    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/66> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "Nissan Motor Manufacturing, Toyota Motor Manufacturing, Calsonic Kansei, ADIANT, DHL, JCB, NAC Group, Caterpillar, Perkins, Jaguar Landrover, Bacoll, BMW, Vision Labs, Cargill Meats Limited, Nifty Lift" ;
    seom:keyword "engineering",
        "health and safety",
        "lean manufacturing operative",
        "logistics",
        "manufacturing" ;
    seom:level 2 ;
    seom:overview "Carrying out manufacturing activities on multiple products with different specifications consecutively." ;
