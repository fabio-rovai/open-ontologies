    seom:inRoute <https://gov.tesseract.academy/id/seom/route/5> ;
    seom:involvedEmployers "Ringway, Kier, Island roads, colas, cormac, viaem, MorganSinal, Volkers, Skanska, SWH Group, BAM Nuttall, CITB, ICE, IHE" ;
    seom:keyword "Highways maintenance skilled operative",
        "construction",
        "highways maintenance",
        "highways repair",
        "roads" ;
    seom:level 2 ;
    seom:overview "Working on rural and urban roads to repair damaged surfaces." ;
