    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "Roquette UK, William Hare Ltd, JCB, MoveTech, Ministry of Defence, KMF, Severfield (UK) Limited, Royal Armoured Corps, Cooney Marine, Unipres (UK) limited, Quinton Major, Renishaw, Siemens, CSPS" ;
    seom:keyword "engineering",
        "engineering operations",
        "engineering operative",
        "manufacturing",
        "operational" ;
    seom:level 2 ;
    seom:overview "Carrying out a range of engineering operations." ;
