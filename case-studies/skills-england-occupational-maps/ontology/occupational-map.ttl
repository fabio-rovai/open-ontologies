    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/5232> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/5232> ;
    seom:statusLastUpdated "2017-06-06"^^xsd:date ;
    seom:stdCode "OCC0352" ;
