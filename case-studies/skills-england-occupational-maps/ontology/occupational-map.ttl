        "building",
        "construction",
        "craft",
        "paint",
        "painter" ;
    seom:level 3 ;
    seom:overview "To provide all aspects of painting and decorating." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC1385A>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC1385B> ;
