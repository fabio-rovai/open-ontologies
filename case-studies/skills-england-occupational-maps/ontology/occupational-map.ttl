    seom:level 6 ;
    seom:overview "Providing excellent care to patients diagnosed with cancer by delivering high quality and accurate radiotherapy." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0554>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0564>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0619> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/2217> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/2254> ;
    seom:statusLastUpdated "2019-04-15"^^xsd:date ;
