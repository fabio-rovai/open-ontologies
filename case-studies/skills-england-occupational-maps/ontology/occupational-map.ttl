    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/1> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/5> ;
    seom:involvedEmployers "Morgan Sindall, Balfour Beatty, Costain, BAM Nuttall, Joseph Gallagher Ltd, Johnston Trenchless Solutions, Tunnelcraft Ltd, IPS, TGTunnelling Ltd, Danny Sullivan Group, Barhale plc, Murphy Group" ;
    seom:keyword "Tunnelling",
        "Tunnelling operative",
        "rail",
        "services",
        "tunnells",
        "undergound",
        "water works" ;
    seom:level 2 ;
    seom:overview "Building the underground tunnels needed for services such as rail lines and water works." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0268>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0513> ;
