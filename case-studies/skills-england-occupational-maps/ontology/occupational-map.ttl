        <https://gov.tesseract.academy/id/seom/occupation/OCC1407> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/5221> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/5221> ;
    seom:statusLastUpdated "2025-05-29"^^xsd:date ;
