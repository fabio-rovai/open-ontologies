        <https://gov.tesseract.academy/id/seom/occupation/OCC0842> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/8232> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/8232> ;
    seom:statusLastUpdated "2015-08-27"^^xsd:date ;
    seom:stdCode "OCC0274" ;
