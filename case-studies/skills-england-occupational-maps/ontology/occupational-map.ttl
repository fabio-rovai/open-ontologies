        "Senior risk specialist" ;
    seom:versionNo "1.1" .

<https://gov.tesseract.academy/id/seom/occupation/OCC0409> a seom:Occupation ;
    rdfs:label "Cyber security technical professional" ;
    dct:description "A cyber security technical professional operates in business or technology / engineering functions across a range of sectors of the economy including critical national infrastructure (such as energy, transport, water, finance), public and private, large and small. They will normally operate with a considerable degree of autonomy and will lead teams which research, analyse, model, assess and manage cyber security risks; design, develop, justify, manage and operate secure solutions; and detect and respond to incidents. They work in accordance with applicable laws, regulations, standards and ethics." ;
    skos:prefLabel "Cyber security technical professional" ;
    seom:atTechnicalLevel <https://gov.tesseract.academy/id/seom/technical-level/3> ;
    seom:deliveredThrough <https://gov.tesseract.academy/id/seom/product/ST0409> ;
    seom:hasStatus <https://gov.tesseract.academy/id/seom/status/1> ;
