        "livestock" ;
    seom:level 3 ;
    seom:overview "Manage the livestock related tasks on the farm." ;
    seom:progressesTo <https://gov.tesseract.academy/id/seom/occupation/OCC0946>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC1320> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/5111> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/5111> ;
    seom:statusLastUpdated "2021-06-29"^^xsd:date ;
