        <https://gov.tesseract.academy/id/seom/occupation/OCC0808> ;
    seom:socMapping2010 <https://gov.tesseract.academy/id/seom/soc/2010/5236> ;
    seom:socMapping2020 <https://gov.tesseract.academy/id/seom/soc/2020/5246> ;
    seom:statusLastUpdated "2018-10-05"^^xsd:date ;
