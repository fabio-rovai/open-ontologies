    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/4> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/6> ;
    seom:involvedEmployers "Christies, Dreweatts, Bellmans, Roseberys, Woolley and Wallis, Society of Fine Art Auctioneers and Valuers (SOFAA), Lawrences Fine Art Auctioneers, The Association of Art & Antiques Dealers (LAPADA), Lyon and Turnbull, The Society of London Art Dealers Ltd (SLAD), Bonhams, Phillips" ;
    seom:keyword "Art Handler",
        "art",
        "art market coordinator",
        "art selling",
        "collectables" ;
    seom:level 3 ;
    seom:overview "Co-ordinating the selling of art, luxury items or collectables in and across the art market with relevant stakeholders." ;
