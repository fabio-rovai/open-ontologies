        <https://gov.tesseract.academy/id/seom/occupation/OCC0039E>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0595>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0908>,
        <https://gov.tesseract.academy/id/seom/occupation/OCC0954> ;
