        <https://gov.tesseract.academy/id/seom/green-theme/5> ;
    seom:inPathway <https://gov.tesseract.academy/id/seom/pathway/15> ;
    seom:inRoute <https://gov.tesseract.academy/id/seom/route/8> ;
    seom:involvedEmployers "National Grid, AMEY, SSE, Freedom Group, Grosvenor Power, IUS, Morrison Utility Services, NIE, Northern Powergrid, Scottish Power, SPIE-ENS, Electricity Northwest, UK Power Networks, WPD, The Institution of Engineering and Technology" ;
    seom:keyword "EPPPC engineering",
        "Electrical engineering",
        "electrical skills",
        "operational",
        "technical support" ;
    seom:level 4 ;
    seom:overview "Carrying out a range of engineering work on power protection systems, plant and equipment." ;
