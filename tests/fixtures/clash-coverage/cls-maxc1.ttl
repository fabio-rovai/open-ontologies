# cls-maxc1   T(?x, owl:maxCardinality, "0"^^xsd:nonNegativeInteger)
#             T(?x, owl:onProperty, ?p) T(?u, rdf:type, ?x) T(?u, ?p, ?y) -> false
# A restriction admitting no value of the property, on an individual that has one.
@prefix : <http://ex.org/clash#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:NoChildren a owl:Restriction ;
    owl:onProperty :parentOf ;
    owl:maxCardinality "0"^^xsd:nonNegativeInteger .
:bob a :NoChildren ;
    :parentOf :carol .
