# cls-com   T(?c1, owl:complementOf, ?c2) T(?x, rdf:type, ?c1) T(?x, rdf:type, ?c2) -> false
# The same shape as cax-dw over complement rather than disjointness. A separate
# detector because no rule in the profile turns one vocabulary into the other.
@prefix : <http://ex.org/clash#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Mortal owl:complementOf :Immortal .
:leo a :Mortal , :Immortal .
