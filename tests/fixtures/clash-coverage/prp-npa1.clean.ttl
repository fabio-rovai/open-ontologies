# The denial alone. Nothing asserts the relation it denies.
@prefix : <http://ex.org/clash#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:denial a owl:NegativePropertyAssertion ;
    owl:sourceIndividual :bob ;
    owl:assertionProperty :parentOf ;
    owl:targetIndividual :carol .
