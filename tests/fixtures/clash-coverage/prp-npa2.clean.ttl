# The denial with a different value asserted.
@prefix : <http://ex.org/clash#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:denial a owl:NegativePropertyAssertion ;
    owl:sourceIndividual :bob ;
    owl:assertionProperty :nickname ;
    owl:targetValue "Bobby" .
:bob :nickname "Robert" .
